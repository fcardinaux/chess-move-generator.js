class CMGMove
    @fromPositionAndMoveString: (startPosition, moveString) ->
        ###
        Get the CMGMove instance that corresponds to the specified move from the specified position
        @param startPosition (CMGPosition)
        @param moveString (string)
        @return (CMGMove|false) Returns a CMGMove instance if valid, false otherwise
        ###
        fromSquare = moveString.substr(0, 2)
        toString = moveString.substr(2, 2)
        promotion = false
        if moveString.length is 5
            promotion = moveString.substr(4)

        @fromPositionAndMoveCoordinates(startPosition, fromSquare, toSquare, promotion)

    @fromPositionAndMoveCoordinates: (startPosition, fromSquare, toSquare, promotion = false) ->
        ###
        Get the CMGMove instance that corresponds to the specified move from the specified position
        @param startPosition (CMGPosition)
        @param fromSquare (integer)
        @param toSquare (integer)
        @param promotion (false|'q'|'r'|'n'|'b')
        @return (CMGMove|false) Returns a CMGMove instance if valid, false otherwise
        ###
        fromPiece = startPosition._getPieceOnSquare(fromSquare)

        toPiece = fromPiece.clone()
        if promotion isnt false
            toPiece.type = promotion

        castling = false
        if fromPiece.type is 'k'
            dist = toSquare - fromSquare
            castling = 'k' if dist is 2
            castling = 'q' if dist is -2

        takenPiece = false
        takenOnSquare = false
        landingSquareContent = startPosition._getPieceOnSquare(toSquare)
        if landingSquareContent
            takenPiece = landingSquareContent.clone()
            takenOnSquare = toSquare
        else if startPosition.enPassantSquare is toSquare
            takenPiece = new CMGPiece(startPosition.opponentColorCode(), 'p')
            if startPosition.enPassantSquare > 31
                takenOnSquare = startPosition.enPassantSquare - 8
            else
                takenOnSquare = startPosition.enPassantSquare + 8

        out = new CMGMove(startPosition, fromSquare, fromPiece, toSquare, toPiece, castling, takenPiece, takenOnSquare)

        if not out.isValid()
            return false

        return out

    constructor: (@startPosition, @fromSquare, @fromPiece, @toSquare, @toPiece, @castling = false, @takenPiece = false, @takenOnSquare = false) ->
        ###
        Constructor
        @param startPosition (CMGPosition)
        @param fromSquare (integer)
        @param fromPiece (CMGPiece)
        @param toSquare (integer)
        @param toPiece (CMGPiece)
        @param castling (false|"q"|"k")
        @param takenPiece (false|CMGPiece)
        @param takenOnSquare (false|integer)
        ###

        @lazy = {}

        @fromSquare     = CMGUtil.toString(@fromSquare)
        @toSquare       = CMGUtil.toString(@toSquare)
        @takenOnSquare  = CMGUtil.toString(@takenOnSquare)

    clone: () ->
        ###
        Clone the current CMGMove instance
        @return CMGMove
        ###
        takenPiece = false
        if @takenPiece
            takenPiece = @takenPiece.clone()
        out = new CMGMove(@startPosition, @fromSquare, @fromPiece.clone(), @toSquare, @toPiece.clone(), @castling, takenPiece, @takenOnSquare)
        return out

    toString:   () ->
        ###
        Convert the current CMGMove to a string
        @return string
        ###
        out = CMGPosition.squareNumberToString(@fromSquare) + CMGPosition.squareNumberToString(@toSquare)
        if @fromPiece.type is 'p' and @toPiece.type isnt 'p'
            out += @toPiece.type.toUpperCase()
        out

    getNewPosition: () ->
        ###
        Get the CMGPosition instance that results from the current move
        @return CMGPosition
        ###
        if not @lazy.hasOwnProperty('end-position')
            @lazy['end-position'] = @startPosition._getNewPositionObjectAfterMove(this)
        @lazy['end-position']

    isEnPassant: () ->
        ###
        Is the current move an "en passant" move
        @return boolean
        ###
        if @takenPiece is false
            return false

        return ( @takenOnSquare isnt @toSquare )

    isValid: () ->
        ###
        Is the current move valid?
        @return boolean
        ###

        # First, test if it is a pseudo move
        isPseudoMove = false
        for pseudoMove in @startPosition._allPseudoMovesFromSquare(@fromSquare)
            if @toSquare isnt pseudoMove.toSquare
                continue
            if @toPiece isnt pseudoMove.toPiece
                continue
            if @castling isnt pseudoMove.castling
                continue
            if @takenPiece isnt pseudoMove.takenPiece
                continue
            if @takenOnSquare isnt pseudoMove.takenOnSquare
                continue
            isPseudoMove = true
            break

        return (isPseudoMove and @isValidPseudoMove() )

    isValidPseudoMove: () ->
        ###
        Assuming the move is a pseudo move of the start position, is it a valid one?
        We must eliminate:
        * pawn taking moves where nothing can be taken (verify also en passant)
        * move after which the king is under chess
        * castling moves that cross a threatened square
        @return boolean
        ###

        if @fromPiece.type is 'p' and ( Math.abs(@toSquare - @fromSquare) % 8 ) isnt 0 and @takenPiece is false
            # A taking move with a pawn, but no piece has been taken
            return CMGPosition.PSEUDO_ONLY

        # The purpose of the following tests is to minimize the number of times @getNewPosition()._opponentKingAttacked() is called.
        doUnprotectionTest = true
        if @fromPiece.type is 'k'

            # King is moved, test if king under attack after move
            if @getNewPosition()._opponentKingAttacked() # opponent of new position, i.e. player of current position
                return CMGPosition.PSEUDO_ONLY

            doUnprotectionTest = false # Not necessary, since we already have tested the end position

        else if @isEnPassant()

            # Subsequent protection tests won't work. Test if king under attack after move
            if @getNewPosition()._opponentKingAttacked() # opponent of new position, i.e. player of current position
                return CMGPosition.PSEUDO_ONLY

            doUnprotectionTest = false # Not necessary, since we already have tested the end position

        else if @startPosition.isKingAttacked()
            # King was under attack before move, test if king protected by landing square
            if not @startPosition._attackedKingProtectedByTargetSquareOfNonKingMove(this)
                return CMGPosition.PSEUDO_ONLY

        # else
        #     # King was not under attack before move,


        if doUnprotectionTest
            # Test if king was protected by piece before move
            protectionDirection = @startPosition._directionOfKingProtectionByOriginatingSquareOfNonKingMove(this)
            if protectionDirection isnt false

                # King may still be protected after move, if move is along protection direction
                testMoveDirection = true
                switch @fromPiece.type
                    when 'n' then testMoveDirection = false
                    when 'b' then testMoveDirection = ( protectionDirection % 2 isnt 0 )
                    when 'r' then testMoveDirection = ( protectionDirection % 2 is 0 )
                moveDirection = false
                if testMoveDirection
                    [moveDirection, dummy] = CMGPosition._direction(@fromSquare, @toSquare) # False if not along one of the 8 directions, e.g. for knights
                if ( moveDirection is false ) or ( Math.abs(moveDirection - protectionDirection) % 4 isnt 0 )
                    return CMGPosition.PSEUDO_ONLY

        # Test if castling is allowed: the king may not be under chess before move, and it may not cross a field that is under chess
        if @fromPiece.type is 'k'
            delta = parseInt(@toSquare) - parseInt(@fromSquare)
            if Math.abs(delta) is 2
                castlingSide = 'k'
                if delta < 0
                    castlingSide = 'q'
                if not @startPosition._castlingPossibleOnSide(castlingSide)
                    return CMGPosition.PSEUDO_ONLY

        return true

