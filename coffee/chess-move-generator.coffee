class CMGPosition
    # -------------------------------------------------------------------------
    # Only for tests:
    @PSEUDO_ONLY = false

    # -------------------------------------------------------------------------
    # Noticeable values:
    @ROW_SPAN:              8
    @BOTTOM_LEFT_CORNER:    0
    @BOTTOM_RIGHT_CORNER:   7
    @TOP_LEFT_CORNER:       56
    @TOP_RIGHT_CORNER:      63

    # -------------------------------------------------------------------------
    # Internal encoding for castling:
    @CASTLING_CODE_ALL:         15
    @CASTLING_CODE_WHITE_KING:   8
    @CASTLING_CODE_WHITE_QUEEN:  4
    @CASTLING_CODE_BLACK_KING:   2
    @CASTLING_CODE_BLACK_QUEEN:  1
    @CASTLING_CODE_ANY_KING:    @CASTLING_CODE_WHITE_KING  | @CASTLING_CODE_BLACK_KING
    @CASTLING_CODE_ANY_QUEEN:   @CASTLING_CODE_WHITE_QUEEN | @CASTLING_CODE_BLACK_QUEEN

    # -------------------------------------------------------------------------
    # Move bitboards
    # Note:
    # @QUEEN_MOVES, @ROOK_MOVES, @BISHOP_MOVES, @KNIGHT_MOVES,
    # @KING_MOVES_WITHOUT_CASTLING, @PAWN_NON_TAKING_MOVES, @PAWN_TAKING_MOVES
    # and @SHADOWS are generated by a metaprogram and placed at the END of this javascript

    @CASTLING_WHITE_KING:   { move: [ 64, 0, 0,     0 ], mustBeEmptyOnQuadrant0: 96 } # Move = king position (  16) x 4
    @CASTLING_WHITE_QUEEN:  { move: [  4, 0, 0,     0 ], mustBeEmptyOnQuadrant0: 14 } # Move = king position (  16) / 4
    @CASTLING_BLACK_KING:   { move: [  0, 0, 0, 16384 ], mustBeEmptyOnQuadrant3: 24576 } # Move = king position (4096) x 4
    @CASTLING_BLACK_QUEEN:  { move: [  0, 0, 0,  1024 ], mustBeEmptyOnQuadrant3: 3584 } # Move = king position (4096) / 4

    # -------------------------------------------------------------------------
    # Public functions of class (comparable to static methods)

    @fromString: (positionString) ->
        ###
        Get an object instance from its Forsyth-Edwards representation

        @param positionString (string) The Forsyth-Edwards representation
        @return CMGPosition
        ###
        elements = positionString.split(' ')
        [boardString, turnChar, allowedCastlingString, enPassantString] = elements

        halfMoveClock = 0
        moveNumber = 1
        switch elements.length
            when 5
                halfMoveClock = parseInt(elements[4])
            when 6
                halfMoveClock = parseInt(elements[4])
                moveNumber = parseInt(elements[5])

        # Process each element one by one
        pieces            = CMGPosition._boardStringToPieces(boardString)
        allowedCastling   = CMGPosition._allowedCastlingStringToValue(allowedCastlingString)
        enPassantSquare   = CMGPosition._enPassantStringToSquare(enPassantString)
        turn              = CMGPosition._turnCharToValue(turnChar)

        # Return the position
        new CMGPosition(pieces, turn, allowedCastling, enPassantSquare, halfMoveClock, moveNumber)

    @squareNumberToString: (squareNumber) ->
        ###
        Get a string that represents a square number

        Examples: 0 -> a1, 7 -> h1

        @param squareNumber (int)
        @return string
        ###
        rowValue = Math.floor(squareNumber / CMGPosition.ROW_SPAN)
        colValue = squareNumber % CMGPosition.ROW_SPAN

        String.fromCharCode(colValue + 97) + String.fromCharCode(rowValue + 49) # 97 is 'a', 49 is '1'

    # -------------------------------------------------------------------------
    # Private functions of class (comparable to static methods)

    @_boardStringToPieces: (boardString) ->
        # Reverse, so that the table SquareTabId is immediately ordered by square ID
        rowStrings = boardString.split('/').reverse()
        CMGPosition._rowStringsToPieces(rowStrings)

    @_rowStringsToPieces: (rowStrings, pieces = [], rowId = 0) ->
        if rowStrings.length isnt 8
            throw "Incorrect number of rows in #{rowStrings}"

        pieces = {}

        for rowString, rowId in rowStrings
            pieces = CMGPosition._squareCharsToPieces(rowString.split(''), pieces, rowId * CMGPosition.ROW_SPAN, rowId * CMGPosition.ROW_SPAN + 7)

        return pieces

    @_squareCharsToPieces: (rowChars, pieces, currentSquareId, lastSquareIdOfRow) ->
        for rowChar in rowChars
            switch rowChar
                when '1' then currentSquareId += 1 # when character is '1'
                when '2' then currentSquareId += 2
                when '3' then currentSquareId += 3
                when '4' then currentSquareId += 4
                when '5' then currentSquareId += 5
                when '6' then currentSquareId += 6
                when '7' then currentSquareId += 7
                when '8' then currentSquareId += 8 # when character is '8'
                else
                    pieces[currentSquareId] = CMGPiece.fromChar( rowChar )
                    currentSquareId += 1

        return pieces

    @_allowedCastlingStringToValue: (allowedCastlingString) ->
        if allowedCastlingString is '-'
            return 0

        func = (acc, pce) ->
            switch pce
                when 'K' then return acc + CMGPosition.CASTLING_CODE_WHITE_KING
                when 'Q' then return acc + CMGPosition.CASTLING_CODE_WHITE_QUEEN
                when 'k' then return acc + CMGPosition.CASTLING_CODE_BLACK_KING
                when 'q' then return acc + CMGPosition.CASTLING_CODE_BLACK_QUEEN
            acc

        allowedCastlingString.split('').reduce(func, 0)

    @_allowedCastlingValueToString: (allowedCastling) ->
        if allowedCastling is 0
            return '-'

        wqChar = wkChar = bqChar = bkChar = ''
        wqChar = 'Q' if allowedCastling & CMGPosition.CASTLING_CODE_WHITE_QUEEN
        wkChar = 'K' if allowedCastling & CMGPosition.CASTLING_CODE_WHITE_KING
        bqChar = 'q' if allowedCastling & CMGPosition.CASTLING_CODE_BLACK_QUEEN
        bkChar = 'k' if allowedCastling & CMGPosition.CASTLING_CODE_BLACK_KING

        allowedCastlingString = [wkChar, wqChar, bkChar, bqChar].join('')

        return allowedCastlingString

    @_enPassantStringToSquare: (enPassantString) ->
        if enPassantString is '-'
            return false

        if enPassantString.length isnt 2
            throw "Invalid en-passant string: #{enPassantString}"
        colValue = enPassantString.charCodeAt(0) - 97 # 'a' in ascii
        rowValue = enPassantString.charCodeAt(1) - 49 # '1' in ascii
        CMGPosition._squareReference(rowValue, colValue)

    @_turnCharToValue: (turnChar) ->
        if turnChar isnt 'b' and turnChar isnt 'w'
            throw "Invalid turn character: #{turnChar}"

        return turnChar

    @_squareReference: (rowId, colId) ->
        CMGPosition.ROW_SPAN * rowId + colId

    @_getPieceOnSquare: (item, squareKey) ->
        pieces = null
        if item instanceof CMGPosition
            pieces = item.pieces
        else
            pieces = item

        if not pieces.hasOwnProperty(squareKey)
            return false

        return pieces[squareKey]

    @_shadow: (square, direction) ->
        # @param direction (int): 0 = north, 1 = north-east, ..., 7 = north-west (i.e. clockwise)
        @SHADOWS[square][direction]

    @_light: (square, direction) ->
        # @param direction (int): 0 = north, 1 = north-east, ..., 7 = north-west (i.e. clockwise)
        @SHADOWS[square][direction ^ 4] # ^ = xor

    @_oppositeColor: (color, defaultValue = false) ->
        switch color
            when "b" then return "w"
            when "w" then return "b"
        defaultValue

    @_direction: (arrowFrom, arrowTo, arrowFromIs0x88 = false) ->
        # Using 0x88 representation allows to check diagonals easily.
        # Without it, doing a simple modulo operation (%9 and %7) would lead to boundary errors.
        b_0x88 = CMGUtil.to0x88representation( arrowTo )
        a_0x88 = CMGUtil.to0x88representation( arrowFrom )  if not arrowFromIs0x88
        a_0x88 = arrowFrom                                  if arrowFromIs0x88
        delta = b_0x88 - a_0x88
        return [false, 0] if delta is 0
        absDelta = Math.abs(delta)

        if absDelta < 8 # Same row
            return [2, absDelta] if delta > 0
            return [6, absDelta]
        else if absDelta % 16 is 0 # Same column
            return [0, absDelta] if delta > 0
            return [4, absDelta]
        else if absDelta % 17 is 0 # Same diagonal NE - SW
            return [1, absDelta] if delta > 0
            return [5, absDelta]
        else if absDelta % 15 is 0 # Same diagonal NW - SE
            return [7, absDelta] if delta > 0
            return [3, absDelta]

        return [false, absDelta]

    # -------------------------------------------------------------------------
    # Constructor

    constructor: (@pieces, @turn, @allowedCastling = 0, @enPassantSquare = false, @halfMoveClock = 0, @moveNumber = 0) ->
        ###
        Constructor
        @param pieces (Object) With object keys = square ids and object values = instances of CMGPiece
        @param turn (false|"b"|"w")
        @param allowedCastling (integer)
        @param enPassantSquare (false|integer where integer is between 0 (bottom right corner) and 63 (top right corner)
        @param halfMoveClock (integer)
        @param moveNumber (integer)
        ###

        @kingSquare = false

        @piecesOfColor = {}
        @piecesOfColor['b'] = {}
        @piecesOfColor['w'] = {}

        if @pieces
            # This test is necessary, because if CMGUtil.cloneObject() is used, the object is first created empty

            for squareId, piece of @pieces
                @piecesOfColor[piece.color][squareId] = piece
                if piece.color is @turn and piece.type is 'k'
                    @kingSquare = squareId

        @bitBoards = {}
        @_generateBitBoards()

        # May be used, e.g., for castling evaluation:
        @lazy = {}

    # -------------------------------------------------------------------------
    # Public functions of object (comparable to non static methods)

    clone: (pieces = false, withLazyObject = false) ->
        ###
        Clone the present CMGPosition instance

        @param pieces (object|false) If false, @pieces will be taken
        @param withLazyObject (boolean) If true, clone the @lazy object as well
        @return CMGPosition
        ###
        if not pieces
            pieces = @pieces
        out = new CMGPosition(pieces, @turn, @allowedCastling, @enPassantSquare, @halfMoveClock, @moveNumber)
        if withLazyObject
            out.lazy = CMGUtil.cloneObject( @lazy )
        return out

    playerColorCode: () ->
        ###
        Get the color code of the player
        @return ('b'|'w')
        ###
        @turn

    opponentColorCode: () ->
        ###
        Get the color code of the opponent
        @return ('b'|'w')
        ###
        CMGPosition._oppositeColor(@turn)

    toString: () ->
        ###
        Get the Forsyth-Edwards representation of the object
        @return string
        ###
        [@toStringWithoutCounters(), @halfMoveClock, @moveNumber].join(' ')

    toStringWithoutCounters: () ->
        ###
        Get the Forsyth-Edwards representation of the object, without the move and half-move counters
        @return string
        ###
        boardString = @_piecesToBoardString(@pieces)
        turnChar = @turn # neither filtering nor transformation necessary in this direction
        allowedCastlingString = CMGPosition._allowedCastlingValueToString(@allowedCastling)
        enPassantString = @_enPassantSquareToString(@enPassantSquare)

        [boardString, turnChar, allowedCastlingString, enPassantString].join(' ')

    isValidMove: (fromSquare, toSquare, promotion = false) ->
        ###
        Determine whether the specified move from the current position is valid
        @param fromSquare (integer)
        @param toSquare (integer)
        @param promotion (false|'q'|'r'|'n'|'b')
        @return boolean
        ###
        move = CMGMove.fromPositionAndMoveCoordinates(this, fromSquare, toSquare, promotion)
        return ( move instanceof CMGMove )

    allPossibleMovesFrom: (squareKey, piece = null) ->
        ###
        Get all possible moves from the specifed square key.
        @param squareKey (int)
        @param piece (null|CMGPiece) Not mandatory. Can be used to avoid having to retreive the piece each time the function is called.
        @return (array)
        ###
        squareKey = CMGUtil.toString(squareKey)

        if not @lazy.hasOwnProperty('almvf')
            @lazy['almvf'] = {}

        if not @lazy['almvf'].hasOwnProperty(squareKey)

            @lazy['almvf'][squareKey] = []

            if not piece
                piece = @_getPieceOnSquare(squareKey)

            if not piece
                return @lazy['almvf'][squareKey]

            if piece.color isnt @turn
                return @lazy['almvf'][squareKey]

            # Search all pseudo moves from the given square
            pseudoMoves = @_allPseudoMovesFromSquare(squareKey)

            # Finally, eliminate invalid moves:
            for pseudoMove in pseudoMoves
                if pseudoMove.isValidPseudoMove()
                    @lazy['almvf'][squareKey].push(pseudoMove)

        return @lazy['almvf'][squareKey]

    allPossibleMoves: () ->
        ###
        Get all possible moves
        @return (array)
        ###
        if not @lazy.hasOwnProperty('almv')
            @lazy['almv'] = []

            for square, piece of @pieces
                if piece.color isnt @turn
                    continue
                moves = @allPossibleMovesFrom(square, piece)
                if moves.length > 0
                    @lazy['almv'] = @lazy['almv'].concat(moves)

        return @lazy['almv']

    isDraw: () ->
        ###
        Is the position a draw
        @return boolean
        ###
        if @allPossibleMoves().length > 0
            return false
        return not @isKingAttacked()

    getWinnerColorCode: () ->
        ###
        Get the winner color code
        @return (false|'b'|'w')
        ###
        if @allPossibleMoves().length > 0
            return false

        if not @isKingAttacked()
            return false

        return @opponentColorCode()

    isKingAttacked: () ->
        ###
        Is the king in chess
        @return boolean
        ###
        return ( not CMGBitBoard.boolNand( @bitBoards.allPiecesOfColorAndType[@turn]['k'], @_pseudoThreatsOnPlayerBeforeMove() ) )

    # -------------------------------------------------------------------------
    # Private functions of object (comparable to non static methods)

    _opponentKingAttacked: () ->
        opponentKingBitBoard = @bitBoards.allPiecesOfColorAndType[@opponentColorCode()]['k']
        return not CMGBitBoard.boolNand( opponentKingBitBoard, @_allPseudoMoveBitBoard() )

    _directionOfKingProtectionByOriginatingSquareOfNonKingMove: (move) ->
        if not @lazy.hasOwnProperty('kprot1')
            @lazy['kprot1'] = {}

        squareKey = CMGUtil.toString( move.fromSquare )
        if not @lazy['kprot1'].hasOwnProperty(squareKey)

            # Test if direction is relevant
            [supposedProtectionDirection, dummy] = CMGPosition._direction(move.fromSquare, @kingSquare)

            if supposedProtectionDirection is false
                @lazy['kprot1'][squareKey] = false
                return @lazy['kprot1'][squareKey]

            # Calculate some useful values from supposedProtectionDirection
            switch supposedProtectionDirection
                when 0 then [towardsKing, oppositeDirection, nonQueenCandidate] = [ 8, 4, 'r'] # the other candidate is the queen
                when 4 then [towardsKing, oppositeDirection, nonQueenCandidate] = [-8, 0, 'r'] #  "    "       "     "   "    "
                when 1 then [towardsKing, oppositeDirection, nonQueenCandidate] = [ 9, 5, 'b'] #  "    "       "     "   "    "
                when 5 then [towardsKing, oppositeDirection, nonQueenCandidate] = [-9, 1, 'b'] #  "    "       "     "   "    "
                when 2 then [towardsKing, oppositeDirection, nonQueenCandidate] = [ 1, 6, 'r'] #  "    "       "     "   "    "
                when 6 then [towardsKing, oppositeDirection, nonQueenCandidate] = [-1, 2, 'r'] #  "    "       "     "   "    "
                when 3 then [towardsKing, oppositeDirection, nonQueenCandidate] = [-7, 7, 'b'] #  "    "       "     "   "    "
                when 7 then [towardsKing, oppositeDirection, nonQueenCandidate] = [ 7, 3, 'b'] #  "    "       "     "   "    "

            # Now test if there anything between the evaluated square and the king
            pieceFoundTowardsKing = false
            evalSquare = CMGUtil.toInteger( move.fromSquare )
            while pieceFoundTowardsKing is false
                evalSquare += towardsKing
                pieceFoundTowardsKing = @_getPieceOnSquare(evalSquare)
                if evalSquare < 0 or evalSquare > 63
                    throw "Oops! Invalid square #{evalSquare}. Moving out of the board towards direction #{supposedProtectionDirection} without encoutering any king?"

            if pieceFoundTowardsKing.type isnt 'k' or pieceFoundTowardsKing.color isnt @turn
                # King is protected by more than one piece in this direction
                @lazy['kprot1'][squareKey] = false
                return @lazy['kprot1'][squareKey]

            # Now test if king would be attacked FROM THIS DIRECTION if the evaluated square were empty
            kingBoundaries = @_kingBoundaries(oppositeDirection, move.fromSquare)

            opponent = @opponentColorCode()

            candidateBitBoard = CMGBitBoard.binOr( @bitBoards.allPiecesOfColorAndType[opponent]['q'], @bitBoards.allPiecesOfColorAndType[opponent][nonQueenCandidate] )
            if CMGBitBoard.boolNand( candidateBitBoard, kingBoundaries )
                # No threat if evaluated square is emptied, so no protection from evaluated piece
                @lazy['kprot1'][squareKey] = false
                return @lazy['kprot1'][squareKey]

            @lazy['kprot1'][squareKey] = supposedProtectionDirection

        @lazy['kprot1'][squareKey]

    _attackedKingProtectedByTargetSquareOfNonKingMove: (move) ->
        if not @lazy.hasOwnProperty('kprot2')
            @lazy['kprot2'] = {}

        squareKey = CMGUtil.toString( move.toSquare )
        if not @lazy['kprot2'].hasOwnProperty(squareKey)

            # Here, we assume the king is attacked before the move, or that it was protected by the moved piece before it moved.
            # We also assume the move is not a pawn taking another "en passant".
            # All these conditions are assumed to be valid when this function is called.

            # Test if king under attack after sample protecting move
            @lazy['kprot2'][squareKey] = not move.getNewPosition()._opponentKingAttacked() # opponent of new position, i.e. player of current position

        @lazy['kprot2'][squareKey]

    _getNewPositionObjectAfterMove: (move) ->
        pieces = CMGUtil.cloneObject( @pieces )

        pieces[move.fromSquare] = null # ensure garbage collection
        delete pieces[move.fromSquare] # remove the element from the object

        if move.takenOnSquare
            pieces[move.takenOnSquare] = null # ensure garbage collection
            delete pieces[move.takenOnSquare] # remove the element from the object

        pieces[move.toSquare] = move.toPiece

        # Move the rook if castling
        if move.castling is 'k'
            if @turn is 'b'
                pieces[61] = pieces[63]
                delete pieces[63]
            if @turn is 'w'
                pieces[5] = pieces[7]
                delete pieces[7]
        else if move.castling is 'q'
            if @turn is 'b'
                pieces[59] = pieces[56]
                delete pieces[56]
            if @turn is 'w'
                pieces[3] = pieces[0]
                delete pieces[0]

        turn = @opponentColorCode()

        # Determine new 'allowed castling' value
        allowedCastling = @allowedCastling
        switch parseInt(move.fromSquare)
            when   0 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_WHITE_QUEEN )
            when   4 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_WHITE_QUEEN & ~ CMGPosition.CASTLING_CODE_WHITE_KING )
            when   7 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_WHITE_KING )
            when  56 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_BLACK_QUEEN )
            when  60 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_BLACK_QUEEN & ~ CMGPosition.CASTLING_CODE_BLACK_KING )
            when  63 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_BLACK_KING )

        if move.takenOnSquare isnt false and move.takenPiece.type is 'r'
            switch parseInt(move.takenOnSquare)
                when   0 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_WHITE_QUEEN )
                when   4 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_WHITE_QUEEN & ~ CMGPosition.CASTLING_CODE_WHITE_KING )
                when   7 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_WHITE_KING )
                when  56 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_BLACK_QUEEN )
                when  60 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_BLACK_QUEEN & ~ CMGPosition.CASTLING_CODE_BLACK_KING )
                when  63 then allowedCastling &= ( ~ CMGPosition.CASTLING_CODE_BLACK_KING )

        enPassantSquare = false
        if move.fromPiece.type is 'p'
            pawnJump = move.toSquare - move.fromSquare
            if Math.abs( pawnJump ) is 16
                enPassantSquare = move.toSquare - pawnJump / 2

        halfMoveClock   = @halfMoveClock
        moveNumber      = @moveNumber
        if moveNumber is 0
            # Without counters
            halfMoveClock = 0
        else
            # With counters
            if turn is 'w'
                moveNumber += 1

            if move.fromPiece.type is 'p'
                halfMoveClock = 0
            else if move.takenPiece
                halfMoveClock = 0
            else
                halfMoveClock += 1

        out = new CMGPosition(pieces, turn, allowedCastling, enPassantSquare, halfMoveClock, moveNumber)
        out

    _allPseudoMoves: () ->
        # These lazy objects are useful in case of chained move generation, typically during the "performance test" (perftsuite.txt)
        if not @lazy.hasOwnProperty('pmv')
            @lazy['pmv'] = [] # Pseudo-move array
            @lazy['pmvs'] = {} # Pseudo-move arrays, one element for each of player's piece
            @lazy['pmvbb'] = [0, 0, 0, 0] # Pseudo-move bitboard
            @lazy['pqrbmvbb'] = [0, 0, 0, 0] # Pseudo-move of queens, rooks and bishops bitboard

            # Temporary bitboard, to reduce the number of binOr operations by calculating @lazy['pmvbb'] only at the end of loop
            temp_pqrbmvbb     = [0, 0, 0, 0]
            temp_not_pqrbmvbb = [0, 0, 0, 0]

            opponent = @opponentColorCode()
            for squareKey, piece of @piecesOfColor[@turn]
                @lazy['pmvs'][squareKey] = []

                # First, seach all "ordinary" pseudo moves
                pseudoMoveBitBoard = @_bitBoardOfPseudoMovesFromSquare(squareKey, piece, @turn, opponent)

                if piece.type is 'b' or piece.type is 'r' or piece.type is 'q'
                    temp_pqrbmvbb = CMGBitBoard.binOr( temp_pqrbmvbb, pseudoMoveBitBoard )
                else
                    temp_not_pqrbmvbb = CMGBitBoard.binOr( temp_not_pqrbmvbb, pseudoMoveBitBoard )

                # Second, convert the move bitboard into a move array, and execute promotion if required
                targets = CMGBitBoard.bitBoardToSquareKeyArray( pseudoMoveBitBoard )
                for target in targets
                    toPiece = piece

                    takenPiece = @_getPieceOnSquare(target)
                    takenOnSquare = false
                    if takenPiece
                        takenOnSquare = target
                    else if piece.type is 'p' and parseInt(target) is @enPassantSquare
                        # Still need to verify if taken 'en passant':
                        iSquareKey = parseInt(squareKey)
                        switch @enPassantSquare - iSquareKey
                            when -9 then takenOnSquare = iSquareKey - 1
                            when -7 then takenOnSquare = iSquareKey + 1
                            when  7 then takenOnSquare = iSquareKey - 1
                            when  9 then takenOnSquare = iSquareKey + 1
                        if takenOnSquare
                            takenPiece = @_getPieceOnSquare(takenOnSquare)

                    if piece.type is 'p' and (target >= CMGPosition.TOP_LEFT_CORNER or target <= CMGPosition.BOTTOM_RIGHT_CORNER)
                        # A promotion
                        for newPieceType in ['q', 'r', 'n', 'b']
                            newPiece = new CMGPiece(piece.color, newPieceType)
                            move = new CMGMove(this, squareKey, piece, target, newPiece, false, takenPiece, takenOnSquare)
                            @lazy['pmvs'][squareKey].push(move)
                    else
                        castling = false
                        if piece.type is 'k' and Math.abs(target - squareKey) is 2
                            if target > squareKey
                                castling = 'k'
                            else
                                castling = 'q'
                        move = new CMGMove(this, squareKey, piece, target, toPiece, castling, takenPiece, takenOnSquare)
                        @lazy['pmvs'][squareKey].push(move)

            @lazy['pmvbb'] = CMGBitBoard.binOr( temp_pqrbmvbb, temp_not_pqrbmvbb )
            @lazy['pqrbmvbb'] = CMGBitBoard.clone( temp_pqrbmvbb )

        return @lazy['pmv']

    _allPseudoMovesFromSquare: (squareKey) ->
        # todo / optimize: avoid loading all pseudo moves from all squares here
        if not @lazy.hasOwnProperty('pmvs')
            @_allPseudoMoves()
        if not @lazy['pmvs'].hasOwnProperty(squareKey)
            return []
        return @lazy['pmvs'][squareKey]

    _allPseudoMoveBitBoard: () ->
        if not @lazy.hasOwnProperty('pmvbb')
            @_allPseudoMoves()
        return @lazy['pmvbb']

    _allPseudoQRBMoveBitBoard: () ->
        if not @lazy.hasOwnProperty('pqrbmvbb')
            @_allPseudoMoves()
        return @lazy['pqrbmvbb']

    _castlingPossibleOnSide: (castlingSide) ->
        if not @lazy.hasOwnProperty('pks')

            @lazy['pks'] =
                'k': 0 < (@allowedCastling & CMGPosition.CASTLING_CODE_ANY_KING)
                'q': 0 < (@allowedCastling & CMGPosition.CASTLING_CODE_ANY_QUEEN)

            if @lazy['pks']['k'] or @lazy['pks']['q']

                threats = @_pseudoThreatsOnPlayerBeforeMove()

                kingSquareBitBoard = @bitBoards.allPiecesOfColorAndType[@turn]['k']
                kingQuadrant = 0
                if @turn is 'b'
                    kingQuadrant = 3

                if 0 < ( kingSquareBitBoard[kingQuadrant] & threats[kingQuadrant] )
                    @lazy['pks']['k'] = false
                    @lazy['pks']['q'] = false
                else
                    if @lazy['pks']['k']
                        @lazy['pks']['k'] = false if 0 < ( (kingSquareBitBoard[kingQuadrant] << 1) & threats[kingQuadrant] )

                    if @lazy['pks']['q']
                        @lazy['pks']['q'] = false if 0 < ( (kingSquareBitBoard[kingQuadrant] >> 1) & threats[kingQuadrant] )

        return @lazy['pks'][castlingSide]

    _pseudoThreatsOnPlayerBeforeMove: () ->
        if not @lazy.hasOwnProperty('ptpbm')

            invPosition = @clone() # Lazy object not cloned, thus the pseudo-move bitboard will be recalculated
            invPosition.turn = @opponentColorCode()
            invPosition.enPassantSquare = false
            invPosition.allowedCastling = false # Avoid unnecessary evaluations

            @lazy['ptpbm'] = invPosition._allPseudoMoveBitBoard()

            @lazy['ptfqrbpbm'] = invPosition._allPseudoQRBMoveBitBoard()

        return @lazy['ptpbm']

    _pseudoThreatsFromQRBOnPlayerBeforeMove: () ->
        if not @lazy.hasOwnProperty('ptfqrbpbm')
            @_pseudoThreatsOnPlayerBeforeMove()
        return @lazy['ptfqrbpbm']

    _kingBoundaries: (direction, emptiedSquareKey) ->
        ###
        Bitmap of boundaries seen by the player's king, when the specified square is emptied.
        Only the specified direction is evaluated.
        ###
        if not @lazy.hasOwnProperty('king-boundaries')
            @lazy['king-boundaries'] = {}

        if not @lazy['king-boundaries'].hasOwnProperty(emptiedSquareKey)
            @lazy['king-boundaries'][emptiedSquareKey] = @_computeBoundaries(@kingSquare, direction, emptiedSquareKey)

        return @lazy['king-boundaries'][emptiedSquareKey]


    _bitBoardOfPseudoMovesFromSquare: (squareKey, movedPiece, stopAtColor = false, stopAfterColor = false) ->
        out = [0, 0, 0, 0]

        if not movedPiece
            return [0, 0, 0, 0]

        switch movedPiece.type
            when 'r'
                shadows = @_computeShadows(squareKey, [0, 2, 4, 6], stopAtColor, stopAfterColor)
                out = CMGBitBoard.binAnd( CMGPosition.ROOK_MOVES[squareKey], CMGBitBoard.binNot(shadows) )
            when 'n'
                out = CMGBitBoard.binAnd( CMGPosition.KNIGHT_MOVES[squareKey], CMGBitBoard.binNot( @bitBoards.allPiecesOfColor[@turn]) )
            when 'b'
                shadows = @_computeShadows(squareKey, [1, 3, 5, 7], stopAtColor, stopAfterColor)
                out = CMGBitBoard.binAnd( CMGPosition.BISHOP_MOVES[squareKey], CMGBitBoard.binNot(shadows) )
            when 'q'
                shadows = @_computeShadows(squareKey, [0..7], stopAtColor, stopAfterColor)
                out = CMGBitBoard.binAnd( CMGPosition.QUEEN_MOVES[squareKey], CMGBitBoard.binNot(shadows) )
            when 'k'
                shadows = @_computeShadows(squareKey, [0..7], stopAtColor, stopAfterColor)
                out = CMGBitBoard.binAnd( CMGPosition.KING_MOVES_WITHOUT_CASTLING[squareKey], CMGBitBoard.binNot(shadows) )

                # Castling move if any
                if movedPiece.color is 'b'
                    if (@allowedCastling & CMGPosition.CASTLING_CODE_BLACK_KING)  and 0 is ( @bitBoards.allPieces[3] & CMGPosition.CASTLING_BLACK_KING.mustBeEmptyOnQuadrant3 )
                        out = CMGBitBoard.binOr( out, CMGPosition.CASTLING_BLACK_KING.move )
                    if (@allowedCastling & CMGPosition.CASTLING_CODE_BLACK_QUEEN) and 0 is ( @bitBoards.allPieces[3] & CMGPosition.CASTLING_BLACK_QUEEN.mustBeEmptyOnQuadrant3 )
                        out = CMGBitBoard.binOr( out, CMGPosition.CASTLING_BLACK_QUEEN.move )
                else
                    if (@allowedCastling & CMGPosition.CASTLING_CODE_WHITE_KING)  and 0 is ( @bitBoards.allPieces[0] & CMGPosition.CASTLING_WHITE_KING.mustBeEmptyOnQuadrant0 )
                        out = CMGBitBoard.binOr( out, CMGPosition.CASTLING_WHITE_KING.move )
                    if (@allowedCastling & CMGPosition.CASTLING_CODE_WHITE_QUEEN) and 0 is ( @bitBoards.allPieces[0] & CMGPosition.CASTLING_WHITE_QUEEN.mustBeEmptyOnQuadrant0 )
                        out = CMGBitBoard.binOr( out, CMGPosition.CASTLING_WHITE_QUEEN.move )

            when 'p'
                shadowDirections = [0] if @turn is 'w'
                shadowDirections = [4] if @turn is 'b'
                allShadows = @_computeShadows(squareKey, shadowDirections, '*')

                # Remember that CMGPosition.PAWN_(NON_)TAKING_MOVES[<color>] is shorter, because pawns on raws 1 and 8 cannot take anything
                pawnMoveArrayKey = squareKey - 8
                nonTakingMoves = CMGBitBoard.binAnd( CMGPosition.PAWN_NON_TAKING_MOVES[@turn][pawnMoveArrayKey], CMGBitBoard.binNot(allShadows) )
                takingMoves = CMGBitBoard.binAnd( CMGPosition.PAWN_TAKING_MOVES[@turn][pawnMoveArrayKey], CMGBitBoard.binNot( @bitBoards.allPiecesOfColor[@turn] ) )
                out = CMGBitBoard.binOr( takingMoves, nonTakingMoves )

        return out

    _computeBoundaries: (origin, directionFilter, skipPieceSquare) ->
        ###
        Compute the boundaries seen from origin in the specified direction
        ###
        origin = CMGUtil.toInteger( origin )
        origin0x88value = CMGUtil.to0x88representation( origin )
        skipPieceSquare = CMGUtil.toInteger( skipPieceSquare )

        boundaryList = [false, false, false, false, false, false, false, false] # One for each direction
        for pieceSquare, piece of @pieces
            pieceSquare = CMGUtil.toInteger( pieceSquare )
            if pieceSquare is origin
                continue # skip the light origin itself
            if pieceSquare is skipPieceSquare
                continue
            [direction, distance] = CMGPosition._direction(origin0x88value, pieceSquare, true) # Third parameter is optimization
            if direction is false or direction isnt directionFilter
                continue
            if boundaryList[direction] is false or boundaryList[direction][0] > distance
                boundaryList[direction] = [distance, pieceSquare]

        boundaries = [0, 0, 0, 0]
        for boundaryDef in boundaryList
            if boundaryDef is false
                continue
            [dummy, boundarySquare] = boundaryDef
            [boundaryQuadrant, boundaryValue] = CMGBitBoard.quadrantAndValueOfSquare(boundarySquare)
            boundaries[boundaryQuadrant] |= boundaryValue

        return boundaries


    _computeShadows: (squareKey, directions, stopAtColor = '*', stopAfterColor = false) ->

        shadowMap = [0, 0, 0, 0]

        if stopAtColor
            shadowMap = CMGBitBoard.binOr( shadowMap, @_computeSingleBehaviorShadows(squareKey, directions, stopAtColor, false) )

        if stopAfterColor
            shadowMap = CMGBitBoard.binOr( shadowMap, @_computeSingleBehaviorShadows(squareKey, directions, stopAfterColor, true) )

        return shadowMap

    _computeSingleBehaviorShadows: (squareKey, directions, stoppingColor = '*', stopAfterOnly = false) ->
        shadowMap = [0, 0, 0, 0]

        pieces = null
        if stoppingColor is '*'
            pieces = @pieces
        else
            pieces = @piecesOfColor[stoppingColor]

        squareKeyBitBoard = CMGBitBoard.valueOfSquare(squareKey)

        for pieceSquare, piece of pieces
            if pieceSquare is squareKey
                continue # skip the light origin itself

            exclusionQuadrant = false
            exclusionValue = false
            if stopAfterOnly
                [exclusionQuadrant, exclusionValue] = CMGBitBoard.quadrantAndValueOfSquare( parseInt(pieceSquare) )
                exclusionValue = (~ exclusionValue) & 0xffff

            for direction in directions
                if not CMGBitBoard.boolNand( CMGPosition._light(pieceSquare, direction), squareKeyBitBoard )
                    newShadows = CMGBitBoard.clone( CMGPosition._shadow(pieceSquare, direction) )
                    if stopAfterOnly
                        newShadows[exclusionQuadrant] &= exclusionValue
                    shadowMap = CMGBitBoard.binOr( shadowMap, newShadows )
                    break # correct direction found, break 1 level
        return shadowMap

    _piecesToBoardString: () ->
        ( @_piecesToRowStrings() ).join('/')

    _piecesToRowStrings: () ->
        rowId = 8
        rowStrings = []

        while rowId > 0
            rowId--
            rowStrings.push( @_piecesOnRowToRowString(rowId) )

        return rowStrings

    _piecesOnRowToRowString: (rowId) ->
        colId = 0
        rowChars = []
        emptySquareCounter = 0

        while colId < 8

            squareKey = CMGPosition._squareReference(rowId, colId)
            pieceFound = @_getPieceOnSquare(squareKey)

            if pieceFound is false
                emptySquareCounter++
            else
                pieceChar = pieceFound.toChar()
                if emptySquareCounter > 0
                    rowChars.push(emptySquareCounter)
                rowChars.push(pieceChar)
                emptySquareCounter = 0

            colId++

        if emptySquareCounter isnt 0
            rowChars.push(emptySquareCounter)

        rowChars.join('')

    _enPassantSquareToString: (squareNumber) ->
        if squareNumber is false
            return '-'

        return CMGPosition.squareNumberToString(squareNumber)

    _getPieceOnSquare: (squareKey) ->
        CMGPosition._getPieceOnSquare(@pieces, squareKey)

    _generateBitBoards: () ->
        @bitBoards.allPieces = [0, 0, 0, 0]
        @bitBoards.allPiecesOfColor =
            'b': [0, 0, 0, 0]
            'w': [0, 0, 0, 0]
        @bitBoards.allPiecesOfColorAndType =
            'b':
                'r': [0, 0, 0, 0]
                'n': [0, 0, 0, 0]
                'b': [0, 0, 0, 0]
                'k': [0, 0, 0, 0]
                'q': [0, 0, 0, 0]
                'p': [0, 0, 0, 0]
            'w':
                'r': [0, 0, 0, 0]
                'n': [0, 0, 0, 0]
                'b': [0, 0, 0, 0]
                'k': [0, 0, 0, 0]
                'q': [0, 0, 0, 0]
                'p': [0, 0, 0, 0]

        for square, {color: color, type: type} of @pieces
            [quadrant, value] = CMGBitBoard.quadrantAndValueOfSquare( parseInt(square) )
            @bitBoards.allPieces[quadrant]                              |= value
            @bitBoards.allPiecesOfColor[color][quadrant]                |= value
            @bitBoards.allPiecesOfColorAndType[color][type][quadrant]   |= value

