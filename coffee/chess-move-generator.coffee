class CMGUtil
    @cloneObject: (obj) ->
        ###
        Function to clone an object

        Source: http://keithdevens.com/weblog/archive/2007/Jun/07/javascript.clone
        @param obj (any) The object to be cloned
        @return any
        ###
        if obj is null or (typeof obj) isnt 'object'
            return obj

        if (obj instanceof CMGPosition) or (obj instanceof CMGMove) or (obj instanceof CMGPiece)
            # Use specific clone function to avoid circular references
            return obj.clone()

        out = new obj.constructor

        for key, value of obj
            out[key] = @cloneObject(value)

        out

    @toString: (value) ->
        ###
        Convert the argument to a string, unless it is already a string
        @param value (string)
        @return string
        ###
        if typeof value isnt 'string'
            return '' + value

        return value

    @toInteger: (value) ->
        ###
        Convert the argument to an integer, unless it is already an integer
        @param value (integer)
        @return integer
        ###
        if typeof value is 'string'
            return parseInt(value)

        if typeof value isnt 'number'
            return 0 # Unknown

        if value % 1 isnt 0
            # Not an integer
            return Math.floor(value)

        return value

    @to0x88representation: (value) ->
        ###
        0x88 representation allows to detect borders easily

        For more information about this representation of a chess board, look at the bibliography
        @param value (integer)
        @return integer
        ###
        value = @toInteger(value)
        for increment in [0..7]
            if value < 8 + 8 * increment
                return value + 8 * increment
        throw "Invalid value #{value}" # this should never happen


    @from0x88representation: (value) ->
        ###
        0x88 representation allows to detect borders easily

        For more information about this representation of a chess board, look at the bibliography
        @param value (integer)
        @return integer
        ###
        value = @toInteger(value)
        for increment in [0..7]
            if value >= 112 - 16 * increment
                return value - 8 * (7 - increment)
        throw "Invalid value #{value}" # this should never happen



